GROQ_API_KEY=your_groq_api_key

# Optional documentation/refinement model overrides.
# GROQ_REFINEMENT_MODEL=openai/gpt-oss-20b
# GROQ_DOCUMENTATION_MODEL=openai/gpt-oss-120b

# Faster-Whisper transcription settings.
# Hardware-aware defaults:
# - GPU default (CUDA available): WHISPER_MODEL=large-v3, WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16
# - CPU fallback (CUDA unavailable): WHISPER_MODEL=small, WHISPER_DEVICE=cpu, WHISPER_COMPUTE_TYPE=int8
# Note: condition_on_previous_text is disabled intentionally to reduce repetition/error propagation across long recordings.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8

# Audio validation constraints.
# AUDIO_MIN_DURATION_SECONDS=0.5
# AUDIO_MAX_DURATION_SECONDS=14400.0
# AUDIO_SILENCE_THRESHOLD=0.001
# AUDIO_SUSPICIOUS_MIN_SIZE_BYTES=1024
# AUDIO_SUSPICIOUS_MAX_SIZE_BYTES=524288000

# Documentation token budgets and cross-chunk context.
# DOCUMENTATION_MAX_INPUT_TOKENS=2600
# DOCUMENTATION_MAX_OUTPUT_TOKENS=2048
# DOCUMENTATION_CHUNK_OVERLAP_WORDS=200
