GROQ_API_KEY=your_groq_api_key

# Optional documentation/refinement model overrides.
# GROQ_REFINEMENT_MODEL=openai/gpt-oss-120b
# GROQ_DOCUMENTATION_MODEL=openai/gpt-oss-20b

# Faster-Whisper transcription settings.
# Automatically defaults to CUDA + float16 if CUDA is available, otherwise CPU + int8.
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
